---
import { SITE } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr__in">
    <div class="ftr__brand">
      <img src={`${base}/images/icons/icon-default.png`} alt="" width="36" height="36" />
      <p>{SITE.name}<span>{SITE.tagline}</span></p>
    </div>

    <nav class="ftr__links" aria-label="Footer">
      <a href={`${base}/`}>Home</a>
      <a href={`${base}/100-envelope-challenge/`}>The challenge</a>
      <a href={`${base}/100-envelope-challenge-calculator/`}>Calculator</a>
      <a href={`${base}/savings-challenge-printables/`}>Printables</a>
      <a href={`${base}/support`}>Support</a>
      <a href={`${base}/privacy`}>Privacy</a>
      <a href={`${base}/terms`}>Terms</a>
      <a href={SITE.appStoreUrl} rel="noopener">App Store</a>
    </nav>
  </div>

  <div class="wrap ftr__legal">
    <p>&copy; {year} Mihails Kuznecovs. All rights reserved.</p>
    <p>Made for people who'd rather save a little every day than a lot once.</p>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    padding-block: 3rem 2rem;
    margin-top: 2rem;
  }

  .ftr__in {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .ftr__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ftr__brand img {
    border-radius: 8px;
  }

  .ftr__brand p {
    margin: 0;
    font-weight: 700;
    line-height: 1.3;
  }

  .ftr__brand span {
    display: block;
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .ftr__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    font-size: 0.95rem;
  }

  .ftr__links a {
    color: var(--text-muted);
  }

  .ftr__links a:hover {
    color: var(--accent);
  }

  .ftr__legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .ftr__legal p {
    margin: 0;
  }
</style>
